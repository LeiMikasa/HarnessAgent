# =============================================================================
#  HarnessAgent configuration
#  Copy this file to `.env` and fill in the values you need.
#      cp .env.example .env
#  .env is gitignored, so your key is never committed.
# =============================================================================

# Which backend to talk to.  One of: deepseek | anthropic | mock
#   deepseek  -> DeepSeek's Anthropic-compatible endpoint (default)
#   anthropic -> Anthropic's official API
#   mock      -> offline scripted model, needs no key (used by the test suite)
AGENT_PROVIDER=deepseek

# Your API key for the selected provider.  Not needed when AGENT_PROVIDER=mock.
#   DeepSeek : https://platform.deepseek.com/api_keys   (starts with sk-)
#   Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-REPLACE_ME

# --- DeepSeek -----------------------------------------------------------------
# DeepSeek serves an Anthropic-compatible API, so no code change is needed.
# Verify the exact model ids your key accepts with:  python preflight.py
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-chat

# Model ids worth trying if the above is rejected (probe them with preflight):
#   deepseek-chat        stable alias for the current general model
#   deepseek-reasoner    reasoning variant
#   deepseek-v4-flash / deepseek-v4-pro

# --- Anthropic (uncomment to switch) ------------------------------------------
# AGENT_PROVIDER=anthropic
# MODEL_ID=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=            # leave unset to use the SDK default

# --- Runtime shape -----------------------------------------------------------

# Directory the agent treats as its workspace root.  Defaults to the cwd.
# AGENT_WORKDIR=/path/to/workspace

# Directory for all persisted harness state (tasks, mailbox, memory,
# transcripts).  Defaults to <workdir>/.agent
# AGENT_STATE_DIR=/path/to/workspace/.agent

# Extra skill directories, separated by ';' on Windows or ':' elsewhere.
# Defaults to <workdir>/skills
# AGENT_SKILL_DIRS=

# --- Limits ------------------------------------------------------------------

# Max output tokens per model call.
# AGENT_MAX_TOKENS=8000

# Max tool-calling turns before the loop gives up on a single user request.
# AGENT_MAX_TURNS=150

# Max turns a subagent may run before it is stopped.
# AGENT_SUBAGENT_MAX_TURNS=150

# Optional separate model for the tool-free goal judge; defaults to MODEL_ID.
# GOAL_EVALUATOR_MODEL_ID=

# Maximum automatic goal continuations per user request.
# AGENT_GOAL_BLOCK_CAP=8

# Permission policy for tool calls that need approval.
#   ask   prompt on the terminal; denies when there is no TTY (fail closed)
#   allow run unattended -- convenient, less safe
#   deny  never allow a risky call
# The --approval / --allow-all flags override this.
AGENT_APPROVAL=ask
